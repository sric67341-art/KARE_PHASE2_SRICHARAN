//Hybrid Inheritance
class GrandFather{
    void gen1(){
        System.out.println("Diamond");
    }
}
class Father extends GrandFather{
    void gen21(){
        System.out.println("Gold");
    }
}
class Son extends Father{
    void gen3(){
        System.out.println("Silver");
    }
}
class Mother extends Father{
    void gen22(){
        System.out.println("money");
    }
}
public class Main {
    public static void main(String[] args) {
        Son obj1=new Son();
        obj1.gen1();
        obj1.gen21();
        obj1.gen3();
        Mother obj=new Mother();
        obj.gen21();
        obj.gen22();
    }
}
//write a java programe to check the specific num is perfect square or not 
// by using fuction with no argument no return type

import java.util.Scanner;

public class Main {
    void perfectsquare(){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt(),flag=0;
        for(int i=0;i<n/2;i++){
            if(i*i==n){
                flag=1;
                System.out.println("Pefetct Square of  "+i);
                break;
            }
        }
        if(flag==0)
            System.out.println("not a Perfect Square");
    }
    public static void main(String[] args) {
        Main obj=new Main();
        obj.perfectsquare();
    }
}
//write a java programe to check the specific num is power of 2 or not 
// by using fuction with  argument no return type

import java.util.Scanner;

public class Main {
    void poweroftwo(int n){
        while(n%2==0){
            n=n/2;
        }
        if(n==1)
            System.out.println("a power of 2");
        else
            System.out.println("Not a power of 2");
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        Main obj=new Main();
        obj.poweroftwo(n);
    }
}
