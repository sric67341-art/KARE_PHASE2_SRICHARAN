  //--------- reverse a number with out using right side combination-----------//
  import java.util.Scanner;

public class Main {

    static void reverse(int n) {
        if (n == 0)
            return;

        System.out.print(n % 10);
        reverse(n / 10);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        reverse(n);
    }
}
