  //------- Adam NUMBER---------------------------//
  import java.util.Scanner;

public class Main {

    public static int reverse(int n) {
        int rev = 0;
        while (n > 0) {
            int digit = n % 10;
            rev = rev * 10 + digit;
            n = n / 10;
        }
        return rev;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int rev = reverse(n);

        int square1 = n * n;
        int square2 = rev * rev;

        int revSquare1 = reverse(square1);

        if (square2 == revSquare1) {
            System.out.println("Adam Number");
        } else {
            System.out.println("Not an Adam Number");
        }
    }
}
