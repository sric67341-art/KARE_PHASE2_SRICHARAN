  //-----amicable pair--------------//
  import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        int sum1 = 0;
        int sum2 = 0;

        // Sum of proper divisors of a
        for (int i = 1; i < a; i++) {
            if (a % i == 0) {
                sum1 += i;
            }
        }

        // Sum of proper divisors of b
        for (int i = 1; i < b; i++) {
            if (b % i == 0) {
                sum2 += i;
            }
        }

        if (sum1 == b && sum2 == a) {
            System.out.println("Amicable Pair");
        } else {
            System.out.println("Not an Amicable Pair");
        }
    }
}
