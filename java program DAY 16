  ------ sort the double linked list---------
  class DoublyLinkedList {

    class Node {
        int data;
        Node next;
        Node prev;

        Node(int data) {
            this.data = data;
        }
    }

    Node head = null;

    // Insert element
    void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;

        while (temp.next != null) {
            temp = temp.next;
        }

        temp.next = newNode;
        newNode.prev = temp;
    }

    // Sort the doubly linked list
    void sort() {
        Node i, j;
        int temp;

        for (i = head; i != null; i = i.next) {
            for (j = i.next; j != null; j = j.next) {

                if (i.data > j.data) {
                    temp = i.data;
                    i.data = j.data;
                    j.data = temp;
                }
            }
        }
    }

    // Display elements
    void display() {
        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {

        DoublyLinkedList list = new DoublyLinkedList();

        list.insert(40);
        list.insert(10);
        list.insert(50);
        list.insert(20);
        list.insert(30);

        System.out.println("Before sorting:");
        list.display();

        list.sort();

        System.out.println("\nAfter sorting:");
        list.display();
    }
}
